{
  "name": "tabmixer-extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Build and validation tooling for the TabMixer browser extension.",
  "scripts": {
    "test": "node --test",
    "lint": "node scripts/lint.mjs",
    "validate": "node scripts/check-manifest.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "package": "node scripts/package-release.mjs",
    "check": "node scripts/lint.mjs && node --test && node scripts/check-manifest.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
